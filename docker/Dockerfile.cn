# 国内网络兜底构建：完全不依赖 Docker Hub 的 node 官方镜像，
# Node 运行时从 npmmirror 下载（约 30MB），基础镜像可用任意 Debian/glibc 镜像。
#
#   docker build -f docker/Dockerfile.cn -t youzhong:1.0.202611070929 .
#
# 需要覆盖基础镜像时：
#   docker build -f docker/Dockerfile.cn --build-arg BASE_IMAGE=debian:bookworm-slim -t youzhong:1.0.202611070929 .

ARG BASE_IMAGE=docker.m.daocloud.io/library/python:3.10-slim
ARG NODE_VERSION=22.23.4

# ---------- 1. Node 运行时 ----------
FROM ${BASE_IMAGE} AS nodebase
ARG NODE_VERSION
ENV NODE_MIRROR=https://cdn.npmmirror.com/binaries/node
# 默认 apt 源在国内很慢，构建时统一换成阿里云镜像
RUN set -eux; \
    if [ -d /etc/apt ]; then \
      find /etc/apt -type f \( -name '*.list' -o -name '*.sources' \) -exec sed -i \
        -e 's|deb.debian.org|mirrors.aliyun.com|g' \
        -e 's|security.debian.org|mirrors.aliyun.com|g' {} +; \
    fi; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl xz-utils make g++ python3; \
    rm -rf /var/lib/apt/lists/*; \
    curl -fsSL "${NODE_MIRROR}/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" -o /tmp/node.tar.xz; \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 --no-same-owner; \
    rm /tmp/node.tar.xz; \
    node -v; npm -v

# ---------- 2. 依赖 ----------
FROM nodebase AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/server/package.json apps/server/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
RUN npm config set registry https://registry.npmmirror.com && npm ci --no-audit --no-fund

# ---------- 3. 前端 ----------
FROM deps AS build
WORKDIR /app
COPY . .
RUN npm -w apps/web run build

# ---------- 4. 运行 ----------
FROM nodebase AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    PORT=10078 \
    HOST=0.0.0.0 \
    DB_FILE=/data/youzhong.db \
    APK_DIR=/data/apk \
    URL_PREFIX= \
    APP_VERSION=1.0.202611070929

COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/apps/web/dist ./apps/web/dist
COPY package.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/server ./apps/server
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh

RUN chmod +x /usr/local/bin/entrypoint.sh && mkdir -p /data/apk

VOLUME ["/data"]
EXPOSE 10078

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||10078)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["node_modules/.bin/tsx", "apps/server/src/index.ts"]
