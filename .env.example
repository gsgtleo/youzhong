# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不会随代码分发
# 所有项都可以用同名环境变量覆盖（docker 里用 environment 即可）

# ---------- 网络 ----------
PORT=10078
HOST=0.0.0.0

# 反向代理子路径。留空＝部署在根路径（http://host:10078/）
# 若 nginx 把 /youzhong/ 原样转发到本服务，则填 /youzhong
URL_PREFIX=

# 位于 nginx / 宝塔等反代之后时设为 true，才能拿到真实客户端 IP
TRUST_PROXY=false

# 额外允许的跨域来源（逗号分隔）。同源部署留空即可
ALLOWED_ORIGINS=

# 版本号：显示在网页/安卓设置页，也用于 /api/version 对比更新
APP_VERSION=1.0.202611081807

# 渠道 Webhook 加密密钥。部署时请改成 ≥32 位随机串，改后已有渠道密钥需重新填写
APP_SECRET=change-me-to-a-long-random-string

# ---------- 数据 ----------
# SQLite 文件路径（相对服务启动目录或绝对路径）
DB_FILE=.data/youzhong.db
# 安卓安装包目录：把 APK 放进去，/apk 下载页自动列出最新包
APK_DIR=../../dist-packages

# ---------- 首次启动 ----------
# 仅当数据库里没有任何用户时生效；不填密码会在日志里打印一次随机密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=管理员

# true 时为新账号生成 3 条示例任务（默认 false，只留一条操作引导）
SEED_DEMO=false

# ---------- 可选 ----------
# 服务器显示名（App 里「测试连接」看到的名称）
SERVER_NAME=有终 · 家庭服务器
# 最多允许创建的账号数
MAX_USERS=10
